#! /usr/bin/env python
# encoding: utf-8
#
# Flare SDIO Driver
#

sources = [
    'sdhci.c',
]

board_sources = {
    'versal': [],
    'zynqmp': [
        'zynqmp-sdhci.c',
    ],
    'zynq7000': [
        'zynq7000-sdhci.c',
    ]
}


def init(ctx):
    pass


def options(opt):
    pass


def configure(conf):
    pass


def build(bld):
    srcs = sources
    if bld.env.FLARE_BOARD in board_sources:
        srcs += board_sources[bld.env.FLARE_BOARD]
    bld.objects(target='flare_sdhci_driver', features='c', source=srcs)
